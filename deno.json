{
  "name": "@riagentic/aio",
  "version": "0.8.1",
  "exports": "./mod.ts",
  "publish": {
    "exclude": ["tests/", "examples/", "docs/", "scripts/", "utils/", "android-template/", "*.md", "init.*"]
  },
  "unstable": ["kv"],
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "jsxImportSourceTypes": "@types/react"
  },
  "imports": {
    "@types/react": "npm:@types/react@^18",
    "react": "npm:react@^18",
    "react-dom": "npm:react-dom@^18",
    "aio": "./mod.ts",
    "esbuild": "npm:esbuild@^0.24",
    "immer": "npm:immer@^10",
    "@std/path": "jsr:@std/path@^1"
  },
  "tasks": {
    "test": "deno test -A --unstable-kv tests/",
    "test:core": "deno test -A --unstable-kv --ignore=tests/am.test.ts,tests/build.test.ts,tests/server.test.ts,tests/tls.test.ts,tests/single-instance-lock.test.ts,tests/cli.test.ts,tests/cli-client.test.ts tests/",
    "check": "deno check mod.ts",
    "lint": "deno lint src/",
    "example": "deno run -A examples/counter/app.ts",
    "am": "deno run -A src/am.ts"
  }
}
