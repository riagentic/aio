{
  "name": "@riagentic/aio",
  "version": "1.0.0-alpha51",
  "appId": "aio",
  "exports": {
    ".": "./mod.ts",
    "./air": "./src/air.ts",
    "./air/compat": "./src/air-compat.ts",
    "./ui": "./src/ui/mod.ts",
    "./jsx-runtime": "./src/jsx-runtime.ts",
    "./server": "./src/server-entry.ts",
    "./state-core": "./src/state-core.ts",
    "./db": "./src/db/mod.ts",
    "./extras": "./src/extras/mod.ts",
    "./sync": "./src/sync/mod.ts",
    "./testing": "./src/cell-test.ts",
    "./schedule": "./src/schedule.ts",
    "./selectors": "./src/selector.ts",
    "./build": "./src/build.ts",
    "./build-all": "./src/build-all.ts",
    "./dev-android": "./src/dev-android.ts",
    "./am": "./src/am.ts",
    "./amui": "./amui/src/app.ts",
    "./doctor": "./src/server/doctor.ts",
    "./aiol": "./aiol/mod.ts"
  },
  "publish": {
    "exclude": [
      "tests/",
      "**/*.test.ts",
      "examples/",
      "docs/",
      "scripts/",
      "utils/",
      "android-template/",
      "CHANGELOG.md",
      "init.*",
      "install.*",
      ".claude/",
      ".katana/",
      "*.md",
      "!README.md",
      "telemetry-id"
    ]
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "lib": [
      "deno.ns",
      "deno.unstable",
      "dom",
      "dom.iterable"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "aio"
  },
  "imports": {
    "@std/testing": "jsr:@std/testing@1.0.17",
    "aio": "./mod.ts",
    "aio/air": "./src/air.ts",
    "aio/air/compat": "./src/air-compat.ts",
    "aio/ui": "./src/ui/mod.ts",
    "aio/jsx-runtime": "./src/jsx-runtime.ts",
    "aio/db": "./src/db/mod.ts",
    "aio/server": "./src/server-entry.ts",
    "aio/state-core": "./src/state-core.ts",
    "aio/extras": "./src/extras/mod.ts",
    "aio/sync": "./src/sync/mod.ts",
    "aio/testing": "./src/cell-test.ts",
    "aio/schedule": "./src/schedule.ts",
    "aio/selectors": "./src/selector.ts",
    "aio/build": "./src/build.ts",
    "esbuild": "npm:esbuild@0.24.2",
    "immer": "npm:immer@10.2.0",
    "@std/path": "jsr:@std/path@1.1.3",
    "@std/jsonc": "jsr:@std/jsonc@1.0.2",
    "@std/assert": "jsr:@std/assert@1.0.19",
    "happy-dom": "npm:happy-dom@17.6.3"
  },
  "fmt": {
    "exclude": [
      "node_modules/",
      "coverage/",
      "dist/",
      "android-template/",
      "docs/content.md"
    ]
  },
  "lint": {
    "exclude": [
      "node_modules/",
      "tests/",
      "scripts/",
      "utils/"
    ]
  },
  "tasks": {
    "test": "AIO_APPS_DIR=$INIT_CWD/.aio-test-home deno run --allow-read --allow-write --allow-env scripts/reset-test-home.ts && AIO_APPS_DIR=$INIT_CWD/.aio-test-home deno test -A tests/ amui/src/",
    "test:onboard": "AIO_APPS_DIR=$INIT_CWD/.aio-test-home AIO_ONBOARD_E2E=1 deno test -A --no-check=remote tests/onboarding-e2e.test.ts tests/run-sh-e2e.test.ts",
    "test:build": "AIO_APPS_DIR=$INIT_CWD/.aio-test-home AIO_BUILD_E2E=1 deno test -A --no-check=remote tests/build-e2e.test.ts",
    "ship": "deno run -A src/build/ship.ts",
    "test:e2e": "AIO_APPS_DIR=$INIT_CWD/.aio-test-home deno run --allow-read --allow-write --allow-env scripts/reset-test-home.ts && AIO_APPS_DIR=$INIT_CWD/.aio-test-home deno test -A --no-check=remote tests/e2e-direct-subscription.test.ts tests/e2e-subscription.test.ts tests/e2e-dispatch-ack.test.ts tests/e2e-ui-chromium.test.ts tests/e2e-blank-screen.test.ts tests/e2e-sync-browser.test.ts",
    "coverage:check": "AIO_APPS_DIR=$INIT_CWD/.aio-test-home deno run --allow-read --allow-write --allow-env scripts/reset-test-home.ts && AIO_APPS_DIR=$INIT_CWD/.aio-test-home deno test -A --coverage=coverage tests/ && deno cache mod.ts src/air.ts src/browser-air.ts src/standalone-air.ts src/cell-test.ts src/am.ts src/build.ts aiol/mod.ts && deno coverage coverage --lcov --output=coverage/lcov.info && deno run --allow-read scripts/check-coverage.ts",
    "test:core": "AIO_APPS_DIR=$INIT_CWD/.aio-test-home deno test -A --ignore=tests/am.test.ts,tests/build.test.ts,tests/server.test.ts,tests/tls.test.ts,tests/single-instance-lock.test.ts,tests/cli.test.ts,tests/cli-client.test.ts,tests/electron-ipc.test.ts,tests/app-modes.test.ts,tests/examples.test.ts,tests/e2e-ui-chromium.test.ts,tests/e2e-remote-lan.test.ts,tests/zero-config.test.ts,tests/cli-bound-cells.test.ts,tests/e2e-blank-screen.test.ts,tests/e2e-bundle-smoke.test.ts,tests/e2e-sync-browser.test.ts tests/",
    "check": "deno check src/ mod.ts aiol/mod.ts examples/ && deno check -c amui/deno.json amui/src/",
    "lint": "deno lint src/ amui/src/",
    "lint:aio": "deno run -A aiol/mod.ts",
    "docs:check": "deno run --allow-read scripts/check-docs.ts",
    "docs:coverage": "deno run --allow-read --allow-run scripts/check-doc-coverage.ts",
    "api:check": "deno run --allow-read --allow-write --allow-run scripts/api-snapshot.ts --check",
    "boundaries": "deno run --allow-read scripts/check-boundaries.ts",
    "check:graph": "deno run -A scripts/check-graph.ts",
    "preflight": "deno run -A scripts/preflight.ts",
    "bench": "deno run -A --v8-flags=--expose-gc scripts/bench.ts",
    "bench:check": "deno run -A --v8-flags=--expose-gc scripts/check-bench.ts",
    "soak": "deno run -A scripts/soak.ts --minutes=10",
    "soak:72h": "deno run -A scripts/soak.ts --minutes=4320",
    "api:update": "deno run --allow-read --allow-write --allow-run scripts/api-snapshot.ts",
    "example": "deno run -A examples/counter/app.ts",
    "am": "deno run -A src/am.ts",
    "amui": "deno run -A amui/src/app.ts --client=browser",
    "compile:client": "deno run -A src/build.ts --client",
    "discover": "deno run -A src/am.ts discover",
    "doctor": "deno run -A src/server/doctor.ts",
    "docs": "deno doc --html --name=aio --output=docs/api-ref mod.ts",
    "docs:index": "deno run --allow-read --allow-write scripts/gen-doc-index.ts",
    "validate:matrix": "AIO_APPS_DIR=$INIT_CWD/.aio-test-home deno test -A tests/examples.test.ts tests/examples-ui.test.ts && AIO_APPS_DIR=$INIT_CWD/.aio-test-home AIO_ONBOARD_E2E=1 deno test -A --no-check=remote tests/onboarding-e2e.test.ts && AIO_BUILD_SMOKE=1 deno test -A tests/am-onboard.test.ts"
  }
}
