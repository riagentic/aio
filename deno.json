{
  "name": "@riagentic/aio",
  "version": "1.0.0-alpha7",
  "appId": "aio",
  "exports": {
    ".": "./mod.ts",
    "./air": "./src/air.ts",
    "./react": "./src/react.ts",
    "./jsx-runtime": "./src/jsx-runtime.ts",
    "./adapters/react": "./src/adapters/react.ts",
    "./adapters/air": "./src/adapters/air.ts",
    "./state-core": "./src/state-core.ts",
    "./src/build": "./src/build.ts",
    "./src/am": "./src/am.ts",
    "./aiol": "./aiol/mod.ts"
  },
  "publish": {
    "exclude": [
      "tests/",
      "examples/",
      "docs/",
      "scripts/",
      "utils/",
      "android-template/",
      "CHANGELOG.md",
      "init.*",
      ".claude/",
      "*.md",
      "!README.md"
    ]
  },
  "unstable": ["kv"],
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "lib": ["deno.ns", "deno.unstable", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "jsxImportSourceTypes": "@types/react"
  },
  "imports": {
    "@std/testing": "jsr:@std/testing@^1.0.17",
    "@types/react": "npm:@types/react@^18",
    "react": "npm:react@^18",
    "react-dom": "npm:react-dom@^18",
    "aio": "./mod.ts",
    "aio/air": "./src/air.ts",
    "aio/react": "./src/react.ts",
    "esbuild": "npm:esbuild@^0.24",
    "immer": "npm:immer@^10",
    "@std/path": "jsr:@std/path@^1",
    "@std/assert": "jsr:@std/assert@^1",
    "happy-dom": "npm:happy-dom@^17"
  },
  "fmt": {
    "exclude": ["node_modules/", "coverage/", "dist/", "android-template/"]
  },
  "lint": {
    "exclude": ["node_modules/", "tests/", "scripts/", "utils/"]
  },
  "tasks": {
    "test": "deno test -A --unstable-kv tests/",
    "test:core": "deno test -A --unstable-kv --ignore=tests/am.test.ts,tests/build.test.ts,tests/server.test.ts,tests/tls.test.ts,tests/single-instance-lock.test.ts,tests/cli.test.ts,tests/cli-client.test.ts,tests/electron-ipc.test.ts,tests/app-modes.test.ts tests/",
    "check": "deno check mod.ts",
    "lint": "deno lint src/",
    "lint:aio": "deno run -A aiol/mod.ts",
    "example": "deno run -A examples/counter/app.ts",
    "am": "deno run -A src/am.ts",
    "docs": "deno doc --html --name=aio --output=docs/api-ref mod.ts"
  }
}
