{
  "name": "@riagentic/aio",
  "version": "1.0.0-alpha15",
  "appId": "aio",
  "exports": {
    ".": "./mod.ts",
    "./air": "./src/air.ts",
    "./air/compat": "./src/air-compat.ts",
    "./jsx-runtime": "./src/jsx-runtime.ts",
    "./state-core": "./src/state-core.ts",
    "./db": "./src/db/mod.ts",
    "./sync": "./src/sync/mod.ts",
    "./testing": "./src/cell-test.ts",
    "./schedule": "./src/schedule.ts",
    "./selectors": "./src/selector.ts",
    "./build": "./src/build.ts",
    "./am": "./src/am.ts",
    "./aiol": "./aiol/mod.ts"
  },
  "publish": {
    "exclude": [
      "tests/",
      "**/*.test.ts",
      "examples/",
      "docs/",
      "scripts/",
      "utils/",
      "android-template/",
      "CHANGELOG.md",
      "init.*",
      ".claude/",
      "*.md",
      "!README.md",
      "telemetry-id"
    ]
  },
  "unstable": ["kv"],
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "lib": ["deno.ns", "deno.unstable", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "aio"
  },
  "imports": {
    "@std/testing": "jsr:@std/testing@1.0.17",
    "aio": "./mod.ts",
    "aio/air": "./src/air.ts",
    "aio/air/compat": "./src/air-compat.ts",
    "aio/jsx-runtime": "./src/jsx-runtime.ts",
    "aio/db": "./src/db/mod.ts",
    "aio/sync": "./src/sync/mod.ts",
    "aio/testing": "./src/cell-test.ts",
    "aio/schedule": "./src/schedule.ts",
    "aio/selectors": "./src/selector.ts",
    "aio/build": "./src/build.ts",
    "esbuild": "npm:esbuild@0.24.2",
    "immer": "npm:immer@10.2.0",
    "@std/path": "jsr:@std/path@1.1.3",
    "@std/assert": "jsr:@std/assert@1.0.19",
    "happy-dom": "npm:happy-dom@17.6.3"
  },
  "fmt": {
    "exclude": [
      "node_modules/",
      "coverage/",
      "dist/",
      "android-template/"
    ]
  },
  "lint": {
    "exclude": ["node_modules/", "tests/", "scripts/", "utils/"]
  },
  "tasks": {
    "test": "deno test -A --unstable-kv tests/",
    "coverage:check": "deno test -A --unstable-kv --coverage=coverage tests/ && deno coverage coverage --lcov --output=coverage/lcov.info && deno run --allow-read scripts/check-coverage.ts",
    "test:core": "deno test -A --unstable-kv --ignore=tests/am.test.ts,tests/build.test.ts,tests/server.test.ts,tests/tls.test.ts,tests/single-instance-lock.test.ts,tests/cli.test.ts,tests/cli-client.test.ts,tests/electron-ipc.test.ts,tests/app-modes.test.ts,tests/examples.test.ts tests/",
    "check": "deno check src/ mod.ts aiol/mod.ts init.ts examples/",
    "lint": "deno lint src/",
    "lint:aio": "deno run -A aiol/mod.ts",
    "docs:check": "deno run --allow-read scripts/check-docs.ts",
    "docs:coverage": "deno run --allow-read --allow-run scripts/check-doc-coverage.ts",
    "api:check": "deno run --allow-read --allow-write --allow-run scripts/api-snapshot.ts --check",
    "boundaries": "deno run --allow-read scripts/check-boundaries.ts",
    "bench": "deno run -A --unstable-kv scripts/bench.ts",
    "soak": "deno run -A --unstable-kv scripts/soak.ts --minutes=10",
    "soak:72h": "deno run -A --unstable-kv scripts/soak.ts --minutes=4320",
    "api:update": "deno run --allow-read --allow-write --allow-run scripts/api-snapshot.ts",
    "example": "deno run -A examples/counter/app.ts",
    "am": "deno run -A src/am.ts",
    "docs": "deno doc --html --name=aio --output=docs/api-ref mod.ts"
  }
}
