{
  "title": "amui",
  "version": "0.1.0",
  "nodeModulesDir": "auto",
  "unstable": [
    "kv"
  ],
  "compilerOptions": {
    "lib": [
      "deno.ns",
      "deno.unstable",
      "dom",
      "dom.iterable"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "aio"
  },
  "imports": {
    "aio": "../mod.ts",
    "aio/air": "../src/air.ts",
    "aio/jsx-runtime": "../src/jsx-runtime.ts",
    "electron": "npm:electron",
    "esbuild": "npm:esbuild@0.24.2",
    "immer": "npm:immer@10.2.0",
    "@std/path": "jsr:@std/path@1.1.3",
    "@std/jsonc": "jsr:@std/jsonc@1",
    "@std/assert": "jsr:@std/assert@1"
  },
  "client": "electron",
  "tasks": {
    "dev": "deno run -A src/app.ts --client=browser",
    "dev:electron": "deno run -A src/app.ts --client=electron",
    "install:electron": "deno run -A ../src/electron-install.ts",
    "build": "deno run -A ../src/build-all.ts --build-spec=../src/build.ts",
    "compile": "deno run -A ../src/build-all.ts --build-spec=../src/build.ts --targets=electron",
    "test": "deno test -A"
  },
  "build": {
    "targets": [
      "electron"
    ]
  }
}
