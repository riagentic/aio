{
  "title": "ex-electron-remote",
  "version": "0.1.0",
  "nodeModulesDir": "auto",
  "unstable": [
    "kv"
  ],
  "compilerOptions": {
    "lib": [
      "deno.ns",
      "deno.unstable",
      "dom",
      "dom.iterable"
    ]
  },
  "imports": {
    "aio": "../../../mod.ts",
    "aio/air": "../../../src/air.ts",
    "aio/jsx-runtime": "../../../src/jsx-runtime.ts",
    "esbuild": "npm:esbuild@0.24.2",
    "immer": "npm:immer@10.2.0",
    "@std/path": "jsr:@std/path@1.1.3",
    "electron": "npm:electron"
  },
  "tasks": {
    "dev": "deno run -A src/app.ts --server-url",
    "install:electron": "deno install --allow-scripts=npm:electron",
    "compile": "deno run -A ../../../src/build.ts --client"
  }
}
