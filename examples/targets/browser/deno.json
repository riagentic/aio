{
  "title": "ex-browser",
  "version": "0.1.0",
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "lib": [
      "deno.ns",
      "deno.unstable",
      "dom",
      "dom.iterable"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "aio"
  },
  "imports": {
    "aio": "../../../mod.ts",
    "aio/air": "../../../src/air.ts",
    "aio/jsx-runtime": "../../../src/jsx-runtime.ts",
    "esbuild": "npm:esbuild@0.24.2",
    "immer": "npm:immer@10.2.0",
    "@std/path": "jsr:@std/path@1.1.3"
  },
  "tasks": {
    "dev": "deno run -A src/app.ts --client=browser",
    "compile": "deno run -A ../../../src/build.ts --compile"
  }
}
