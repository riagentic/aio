{
  "title": "ex-contacts",
  "version": "0.1.0",
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "lib": [
      "deno.ns",
      "deno.unstable",
      "dom",
      "dom.iterable"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "aio"
  },
  "imports": {
    "aio": "../../mod.ts",
    "aio/air": "../../src/air.ts",
    "aio/ui": "../../src/ui/mod.ts",
    "aio/jsx-runtime": "../../src/jsx-runtime.ts",
    "aio/server": "../../src/server-entry.ts",
    "aio/extras": "../../src/extras/mod.ts",
    "aio/updates": "../../src/updates.ts",
    "aio/testing": "../../src/cell-test.ts",
    "electron": "npm:electron@^44.3.0",
    "esbuild": "npm:esbuild@0.24.2",
    "immer": "npm:immer@10.2.0",
    "happy-dom": "npm:happy-dom@17.6.3",
    "@std/path": "jsr:@std/path@1.1.3",
    "@std/assert": "jsr:@std/assert@1.0.19"
  },
  "tasks": {
    "dev": "deno run -A src/app.ts",
    "build": "deno run -A ../../src/build-all.ts --build-spec=../../src/build.ts",
    "compile": "deno run -A ../../src/build-all.ts --build-spec=../../src/build.ts --targets=browser",
    "check": "deno check .",
    "lint": "deno run -A ../../aiol/mod.ts",
    "am": "deno run -A ../../src/am.ts"
  },
  "build": {
    "targets": [
      "browser"
    ]
  }
}
